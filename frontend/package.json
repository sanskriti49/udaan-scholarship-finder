{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"scanner:assets": "node scripts/scanner-assets.mjs",
		"predev": "npm run scanner:assets",
		"prebuild": "npm run scanner:assets",
		"test:scanner": "node --test test/scanner.test.mjs test/scanner-handoff.test.mjs test/document-audit.test.mjs test/audit-presentation.test.mjs",
		"test": "node --test test/*.test.mjs",
		"test:smoke": "playwright test app-smoke.spec.mjs",
		"test:navigator:ui": "playwright test navigator.spec.mjs",
		"check": "npm run lint && npm test && npm run build && npm run test:smoke",
		"test:scanner:ui": "playwright test",
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint . --max-warnings 0",
		"preview": "vite preview"
	},
	"dependencies": {
		"@gsap/react": "^2.1.2",
		"@react-oauth/google": "^0.13.5",
		"@tailwindcss/vite": "^4.3.1",
		"@tesseract.js-data/eng": "1.0.0",
		"@tesseract.js-data/hin": "1.0.0",
		"axios": "^1.18.1",
		"gsap": "^3.15.0",
		"hamburger-react": "^2.5.2",
		"lucide-react": "^1.21.0",
		"pdfjs-dist": "6.4.299",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.0",
		"react-turnstile": "^1.1.5",
		"sonner": "^2.0.7",
		"tailwindcss": "^4.3.1",
		"tesseract.js": "7.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"eslint": "^10.5.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.6.0",
		"vite": "^8.1.0"
	}

      "eligibilityCriteria": {
        "eligibilityDescription": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Beneficiary must be a resident of Uttar Pradesh."
                  }
                ],
                "type": "list_item"
              },
              {
                "children": [
                  {
                    "text": "Beneficiary must belong to the General category."
                  }
                ],
                "type": "list_item"
              },
              {
                "children": [
                  {
                    "text": "Beneficiaries who are dependents of people in occupations traditionally considered untouchable."
                  }
                ],
                "type": "list_item"
              },
              {
                "children": [
                  {
                    "text": "Beneficiaries' parents' annual income should not be more than ₹2,50,000/-."
                  }
                ],
                "type": "list_item"
              },
              {
                "children": [
                  {
                    "text": "All the children of the applicant's parents will be eligible."
